<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  {#- GitHub Pages cannot send headers, so the CSP is a meta tag. Must equal dashboard.CSP (tested). #}
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; base-uri 'none'; form-action 'none'">
  <meta name="referrer" content="no-referrer">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>QuakeWatch</title>
  <style>
    :root {
      color-scheme: light;
      --surface: #fcfcfb; --page: #f4f3f1; --line: #e3e2de;
      --text: #0b0b0b; --muted: #52514e;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--page); color: var(--text);
           font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
    header, main, footer { max-width: 1200px; margin: 0 auto; padding: 16px; }
    h1 { margin: 0; font-size: 1.6rem; }
    .sub { margin: 2px 0 16px; color: var(--muted); }
    .tiles { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); }
    .tile { min-width: 0; padding: 12px 14px; background: var(--surface);
            border: 1px solid var(--line); border-radius: 8px; }
    .label { display: block; color: var(--muted); font-size: .78rem;
             letter-spacing: .04em; text-transform: uppercase; }
    .value { display: block; font-size: 1.4rem; font-weight: 600; overflow-wrap: anywhere; }
    .detail { display: block; color: var(--muted); font-size: .85rem; overflow-wrap: anywhere; }
    .charts { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr)); }
    .chart { min-width: 0; min-height: 360px; background: var(--surface);
             border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
    .chart.wide { grid-column: 1 / -1; min-height: 520px; }
    .empty { padding: 40px 16px; text-align: center; color: var(--muted); background: var(--surface);
             border: 1px dashed var(--line); border-radius: 8px; }
    footer { color: var(--muted); font-size: .85rem; }
    footer a { color: inherit; }
  </style>
  <script src="plotly.min.js" defer></script>
  <script src="geo-assets.js" defer></script>
  <script src="figures.js" defer></script>
  <script src="app.js" defer></script>
</head>
<body>
<header>
  <h1>QuakeWatch</h1>
  <p class="sub">Earthquakes from the USGS feed · updated {{ generated_at }}</p>
  <section class="tiles" aria-label="Summary">
    <div class="tile">
      <span class="label">Events stored</span>
      <span class="value">{{ stats.total }}</span>
      {% if stats.total %}<span class="detail">{{ stats.first }} to {{ stats.last }}</span>{% endif %}
    </div>
    {% if stats.total %}
    <div class="tile">
      <span class="label">Last {{ recent_days }} days</span>
      <span class="value">{{ stats.recent }}</span>
      <span class="detail">mean magnitude {{ "%.1f"|format(stats.mean_mag) }}</span>
    </div>
    <div class="tile">
      <span class="label">Largest, last {{ recent_days }} days</span>
      <span class="value">M{{ "%.1f"|format(stats.largest_mag) }}</span>
      <span class="detail">{{ stats.largest_place }} · {{ stats.largest_time }}</span>
    </div>
    <div class="tile">
      <span class="label">Most active region</span>
      <span class="value">{{ stats.top_region }}</span>
      <span class="detail">{{ stats.top_region_count }} events in the last {{ recent_days }} days</span>
    </div>
    {% endif %}
    {% if report %}
    <div class="tile">
      <span class="label">Latest run</span>
      <span class="value">{{ report.accepted }} / {{ report.total }}</span>
      <span class="detail">rows accepted{% for reason, n in report.reasons|dictsort %} · {{ reason|replace("_", " ") }}: {{ n }}{% endfor %}</span>
    </div>
    {% endif %}
  </section>
</header>
<main>
  {% if stats.total %}
  <section class="charts" aria-label="Charts">
    <div id="chart-daily" class="chart"></div>
    <div id="chart-magnitudes" class="chart"></div>
    <div id="chart-map" class="chart wide"></div>
  </section>
  {% else %}
  <p class="empty">No earthquakes recorded yet. The next scheduled run will fill this in.</p>
  {% endif %}
</main>
<footer>
  Data: <a href="https://earthquake.usgs.gov/earthquakes/feed/" rel="noopener noreferrer">U.S. Geological Survey earthquake feed</a>.
  Static page: no cookies, no analytics, no third-party requests.
</footer>
</body>
</html>
